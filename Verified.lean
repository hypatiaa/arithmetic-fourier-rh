/- BEGIN ZetaProductLogDerivative.lean -/

open Filter
noncomputable section
namespace RHConnections.CanonicalFactor
open SpectralTail RelativeResolvent

theorem zetaFactor_logDerivative (r : RepeatedZetaZero) (s : ℂ) (hs : s ≠ r.1.val) :
    logDeriv (zetaFactor r) s = (s-r.1.val)⁻¹ + (r.1.val)⁻¹ := by
  obtain ⟨δ, hδ, hd⟩ := zeta_zero_norm_lower
  have hr : r.1.val ≠ 0 := norm_pos_iff.mp (hδ.trans_le (hd r.1))
  let g := fun t : ℂ => 1-t/r.1.val
  let h := fun t : ℂ => Complex.exp (t/r.1.val)
  have hg : HasDerivAt g (-1/r.1.val) s := by
    simpa only [g, id_eq, neg_div] using ((hasDerivAt_id s).div_const r.1.val).const_sub 1
  have hh : HasDerivAt h (Complex.exp (s/r.1.val)*(1/r.1.val)) s := by
    simpa only [h, id_eq, mul_comm] using ((hasDerivAt_id s).div_const r.1.val).cexp
  have hg0 : g s ≠ 0 := by
    intro he
    have he' : s/r.1.val = 1 := (sub_eq_zero.mp he).symm
    exact hs (by simpa using (div_eq_iff hr).mp he')
  have hEq : zetaFactor r = g*h := rfl
  rw [hEq, logDeriv_mul (f := g) (g := h) s hg0 (Complex.exp_ne_zero _) hg.differentiableAt hh.differentiableAt,
    logDeriv_apply, logDeriv_apply, hg.deriv, hh.deriv]
  dsimp [g,h] at *
  field_simp [hr, hs, sub_ne_zero.mpr hs, Complex.exp_ne_zero]
  <;> ring

theorem zetaCanonicalProduct_logDerivative_limit {s : ℂ}
    (hs : ∀ r : NontrivialZetaZero, s ≠ r.val) :
    Tendsto (fun S : Finset RepeatedZetaZero =>
      ∑ r ∈ S, ((s-r.1.val)⁻¹ + (r.1.val)⁻¹)) atTop
      (nhds (logDeriv zetaCanonicalProduct s)) := by
  have h := hasProdLocallyUniformlyOn_iff_tendstoLocallyUniformlyOn.mp
    zetaCanonicalProduct_locally_uniform
  let F := fun S : Finset RepeatedZetaZero => fun w : ℂ => ∏ r ∈ S, zetaFactor r w
  have hF : ∀ᶠ S in (atTop : Filter (Finset RepeatedZetaZero)),
      DifferentiableOn ℂ (F S) Set.univ := .of_forall fun S => by
    simpa only [F, Finset.prod_fn] using (DifferentiableOn.finsetProd (u := S) (f := zetaFactor) (s := Set.univ)
      (fun r _ => (zetaFactor_differentiable r).differentiableOn (s := Set.univ)))
  have hl : TendstoLocallyUniformlyOn F zetaCanonicalProduct atTop Set.univ := h
  have hvalue := hl.tendsto_at (Set.mem_univ s)
  have hderiv := (hl.deriv hF isOpen_univ).tendsto_at (Set.mem_univ s)
  have hld := hderiv.div hvalue (zetaCanonicalProduct_ne_zero hs)
  apply hld.congr'
  filter_upwards with S
  have hfin := logDeriv_fun_prod (s := S) (f := zetaFactor)
    (fun r _ h => hs r.1 ((zetaFactor_eq_zero_iff r s).mp h))
    (fun r _ => zetaFactor_differentiable r s)
  change logDeriv (F S) s = _
  rw [hfin]
  exact Finset.sum_congr rfl (fun r _ => zetaFactor_logDerivative r s (hs r.1))

theorem zetaCanonicalProduct_relative_logDerivative {s s₀ : ℂ}
    (hs : ∀ r : NontrivialZetaZero, s ≠ r.val)
    (hs₀ : ∀ r : NontrivialZetaZero, s₀ ≠ r.val) :
    HasSum (fun r : RepeatedZetaZero => relative s s₀ r.1.val)
      (logDeriv zetaCanonicalProduct s - logDeriv zetaCanonicalProduct s₀) := by
  have h := (zetaCanonicalProduct_logDerivative_limit hs).sub
    (zetaCanonicalProduct_logDerivative_limit hs₀)
  apply h.congr'
  filter_upwards with S
  rw [← Finset.sum_sub_distrib]
  exact Finset.sum_congr rfl fun r _ => by unfold relative; ring

end RHConnections.CanonicalFactor
end

/- END ZetaProductLogDerivative.lean -/

/- BEGIN HadamardRelative.lean -/

open Filter
namespace RHConnections.CanonicalFactor
open SpectralTail RelativeResolvent PoleCompensation

def ZetaHadamardFactorization : Prop :=
  ∃ B : ℂ, ∀ s : ℂ, entireXi s = Complex.exp (B*s) * zetaCanonicalProduct s

theorem entireXi_logDerivative_of_hadamard {B : ℂ}
    (hB : ∀ s : ℂ, entireXi s = Complex.exp (B*s) * zetaCanonicalProduct s)
    {s : ℂ} (hs : ∀ r : NontrivialZetaZero, s ≠ r.val) :
    logDeriv entireXi s = B + logDeriv zetaCanonicalProduct s := by
  have he : entireXi = fun t : ℂ => Complex.exp (B*t)*zetaCanonicalProduct t :=
    funext hB
  have hd : HasDerivAt (fun t : ℂ => Complex.exp (B*t))
      (Complex.exp (B*s)*B) s := by
    simpa only [id_eq, mul_one] using ((hasDerivAt_id s).const_mul B).cexp
  rw [he, logDeriv_fun_mul (f := fun t : ℂ => Complex.exp (B*t)) (g := zetaCanonicalProduct)
    s (Complex.exp_ne_zero _) (zetaCanonicalProduct_ne_zero hs)
    hd.differentiableAt (zetaCanonicalProduct_entire s (Set.mem_univ s)).differentiableAt,
    logDeriv_apply (fun t : ℂ => Complex.exp (B*t)), hd.deriv]
  rw [mul_comm (Complex.exp (B*s)) B, mul_div_cancel_right₀ _ (Complex.exp_ne_zero _)]

theorem entireXi_relative_logDerivative (h : ZetaHadamardFactorization)
    {s s₀ : ℂ} (hs : ∀ r : NontrivialZetaZero, s ≠ r.val)
    (hs₀ : ∀ r : NontrivialZetaZero, s₀ ≠ r.val) :
    HasSum (fun r : RepeatedZetaZero => relative s s₀ r.1.val)
      (logDeriv entireXi s - logDeriv entireXi s₀) := by
  obtain ⟨B,hB⟩ := h
  rw [entireXi_logDerivative_of_hadamard hB hs, entireXi_logDerivative_of_hadamard hB hs₀]
  simpa using zetaCanonicalProduct_relative_logDerivative hs hs₀

theorem zetaSpectralRelative_eq_logDerivative (h : ZetaHadamardFactorization)
    {z z₀ : ℂ} (hz : 1/2 < z.re) (hz₀ : 1/2 < z₀.re) :
    zetaSpectralRelative z z₀ =
      logDeriv entireXi (z+1/2) - logDeriv entireXi (z₀+1/2) := by
  have hh (w : ℂ) (hw : 1/2 < w.re) (r : NontrivialZetaZero) : w+1/2 ≠ r.val := by
    intro he
    have h := congrArg Complex.re he
    have ht := r.property.1.2
    norm_num [Complex.add_re, Complex.div_re] at h
    linarith
  have hSum := entireXi_relative_logDerivative h (hh z hz) (hh z₀ hz₀)
  rw [← hSum.tsum_eq, hSum.summable.tsum_sigma' (fun _ => (hasSum_fintype _).summable)]
  unfold zetaSpectralRelative
  apply tsum_congr
  intro r
  have he (v : ℂ) : (v+(1/2:ℂ))-r.val = v-(r.val-1/2) := by ring
  simp only [relative, he, tsum_fintype, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

end RHConnections.CanonicalFactor
/- END HadamardRelative.lean -/

/- BEGIN XiEulerMatch.lean -/

namespace RHConnections.PoleCompensation
open SpectralTail CanonicalFactor RelativeResolvent

theorem entireXi_logDerivative_euler {s : ℂ} (hs : 1 < s.re) :
    logDeriv entireXi s = 1/s + 1/(s-1) + logDeriv Complex.Gammaℝ s +
      logDeriv riemannZeta s := by
  have hs' : 0 < s.re := zero_lt_one.trans hs
  have h0 : s ≠ 0 := by intro h; simp [h] at hs; linarith
  have h1 : s ≠ 1 := by intro h; simp [h] at hs
  have hZ := riemannZeta_ne_zero_of_one_le_re hs.le
  have hG := gamma_real_nonzero_of_re_pos hs'
  have hGA := (gamma_real_analytic_of_re_pos hs').differentiableAt
  have hD := differentiableAt_riemannZeta h1
  have hg := entireXi_zeta_germ hs' h1
  have he : logDeriv entireXi s =
      logDeriv (fun t => (t*(t-1)*Complex.Gammaℝ t)*riemannZeta t) s := by
    rw [logDeriv_apply, logDeriv_apply, hg.deriv_eq, hg.eq_of_nhds]
  have hc : HasDerivAt (fun t : ℂ => t-1) 1 s := (hasDerivAt_id s).sub_const 1
  have h01 := mul_ne_zero h0 (sub_ne_zero.mpr h1)
  have hab : DifferentiableAt ℂ (fun t : ℂ => t*(t-1)) s :=
    differentiableAt_id.mul hc.differentiableAt
  rw [he, logDeriv_fun_mul (f := fun t : ℂ => t*(t-1)*Complex.Gammaℝ t)
      (g := riemannZeta) s (mul_ne_zero h01 hG) hZ (hab.mul hGA) hD,
    logDeriv_fun_mul (f := fun t : ℂ => t*(t-1)) (g := Complex.Gammaℝ) s h01 hG hab hGA,
    logDeriv_fun_mul (f := fun t : ℂ => t) (g := fun t : ℂ => t-1) s
      h0 (sub_ne_zero.mpr h1) differentiableAt_id hc.differentiableAt,
    logDeriv_id', logDeriv_apply (fun t : ℂ => t-1), hc.deriv]

theorem compensated_zeta_spectral_euler_match (hH : ZetaHadamardFactorization)
    (z z₀ : ℂ) (hz : 1/2 < z.re) (hz₀ : 1/2 < z₀.re)
    (hA : realPlaceRelative z z₀ =
      logDeriv Complex.Gammaℝ (z₀+1/2) - logDeriv Complex.Gammaℝ (z+1/2)) :
    compensatedLogDerivative (z+1/2) - compensatedLogDerivative (z₀+1/2) =
      relative z z₀ ((-1/2:ℝ):ℂ) - zetaSpectralRelative z z₀ - realPlaceRelative z z₀ := by
  have hs : 1 < (z+(1/2:ℂ)).re := by norm_num [Complex.add_re, Complex.div_re]; linarith
  have hs₀ : 1 < (z₀+(1/2:ℂ)).re := by norm_num [Complex.add_re, Complex.div_re]; linarith
  rw [hA, zetaSpectralRelative_eq_logDerivative hH hz hz₀,
    entireXi_logDerivative_euler hs, entireXi_logDerivative_euler hs₀]
  rw [show ((-1/2 : ℝ) : ℂ) = -(1/2:ℂ) by norm_num]
  simp only [compensatedLogDerivative, logDeriv_apply, relative, Complex.ofReal_div,
    Complex.ofReal_neg, Complex.ofReal_one, Complex.ofReal_ofNat, sub_neg_eq_add, one_div,
    neg_div]
  ring

end RHConnections.PoleCompensation
/- END XiEulerMatch.lean -/

/- BEGIN EntireXiZeroSet.lean -/

namespace RHConnections.SpectralTail

theorem entireXi_reflection (s : ℂ) : entireXi (1-s) = entireXi s := by
  unfold entireXi
  rw [completedRiemannZeta₀_one_sub]
  ring

theorem entireXi_ne_zero_of_one_le_re {s : ℂ} (hs : 1 ≤ s.re) : entireXi s ≠ 0 := by
  by_cases h1 : s = 1
  · subst s
    simp [entireXi]
  have hs' : 0 < s.re := zero_lt_one.trans_le hs
  have h0 : s ≠ 0 := by intro he; simpa [he] using hs'
  rw [(entireXi_zeta_germ hs' h1).eq_of_nhds]
  exact mul_ne_zero
    (mul_ne_zero (mul_ne_zero h0 (sub_ne_zero.mpr h1)) (gamma_real_nonzero_of_re_pos hs'))
    (riemannZeta_ne_zero_of_one_le_re hs)

theorem entireXi_eq_zero_iff (s : ℂ) :
    entireXi s = 0 ↔ (0 < s.re ∧ s.re < 1) ∧ riemannZeta s = 0 := by
  constructor
  · intro h
    have hl : 0 < s.re := by
      by_contra! hn
      have hh : 1 ≤ (1-s).re := by simp only [Complex.sub_re, Complex.one_re]; linarith
      exact entireXi_ne_zero_of_one_le_re hh ((entireXi_reflection s).trans h)
    have hr : s.re < 1 := lt_of_not_ge (fun hn => entireXi_ne_zero_of_one_le_re hn h)
    have h1 : s ≠ 1 := by intro he; simpa [he] using hr
    have h0 : s ≠ 0 := by intro he; simpa [he] using hl
    rw [(entireXi_zeta_germ hl h1).eq_of_nhds] at h
    exact ⟨⟨hl,hr⟩, (mul_eq_zero.mp h).resolve_left
      (mul_ne_zero (mul_ne_zero h0 (sub_ne_zero.mpr h1)) (gamma_real_nonzero_of_re_pos hl))⟩
  · rintro ⟨⟨hl,hr⟩, h⟩
    have h1 : s ≠ 1 := by intro he; simpa [he] using hr
    rw [(entireXi_zeta_germ hl h1).eq_of_nhds, h, mul_zero]

end RHConnections.SpectralTail
