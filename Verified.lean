theorem right_potential_frozen_lipschitz (hIngham : ZetaDensityPremise) :
    ∃ C : ℝ, 0≤C ∧ ∀ q : ℝ, 1<q → 2*q^(1/8:ℝ)≤q^(1/6:ℝ) →
