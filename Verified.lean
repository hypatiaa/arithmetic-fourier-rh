theorem rightSet_finite (T : ℝ) : (rightSet T).Finite := by
  let H := Real.exp (T/3)
  have hH : 0 < H := Real.exp_pos _
  have hε : 0 < 1/H^2 := by positivity
  have hev : ∀ᶠ r : NontrivialZetaZero in cofinite, w2 r < 1/H^2 :=
    zeta_inverse_square_with_multiplicity.tendsto_cofinite_zero.eventually_lt
      (tendsto_const_nhds (x := 1/H^2)) hε
  apply (show {r : NontrivialZetaZero | ¬ w2 r < 1/H^2}.Finite from hev).subset
  intro r hr
  have hN : 0 < ‖r.val‖ := by
    obtain ⟨d, hd, h⟩ := zeta_zero_norm_lower
    exact hd.trans_le (h r)
  obtain ⟨ha,hord⟩ := zeta_nontrivial_zero_finite_order r
  have hm : (1:ℝ) ≤ analyticOrderNatAt riemannZeta r.val := by
    exact_mod_cast (Nat.succ_le_of_lt (zero_order_positive r.property.2 ha hord))
  have hnorm : ‖r.val‖ ≤ H := hr.2
  change ¬ w2 r < 1/H^2
  apply not_lt.mpr
  calc
    _ ≤ 1/‖r.val‖^2 := div_le_div_of_nonneg_left zero_le_one (sq_pos_of_pos hN)
      (pow_le_pow_left₀ hN.le hnorm 2)
    _ ≤ _ := div_le_div_of_nonneg_right hm (sq_nonneg _)

theorem rightSum_finite (T : ℝ) (f : ℝ → ℂ) :
    rightSum T f = ∑ r ∈ (rightSet_finite T).toFinset, compactZeroTerm (scaleTest T f) r := by
  classical
  unfold rightSum
  rw [tsum_eq_sum (s := (rightSet_finite T).toFinset) (fun r hr =>
    indicator_of_notMem (by simpa using hr) _)]
  apply Finset.sum_congr rfl
  intro r hr
  exact indicator_of_mem (by simpa using hr) _

theorem dyadic_endpoint_reduction_X :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ X : ℝ, Real.exp 2 ≤ X →
      |(Chebyshev.psi (2*X)-Chebyshev.psi X)-X| ≤
        (X/Real.exp 1)*dyadicRight (Real.log X - 1) + C*X^(11/12 : ℝ) := by
  obtain ⟨C,hC,h⟩ := dyadic_endpoint_reduction
  refine ⟨C,hC,?_⟩
  intro X hX
  have hX0 := (Real.exp_pos 2).trans_le hX
  let T := Real.log X-1
  have hT : 1 ≤ T := by
    have e := Real.log_le_log (Real.exp_pos 2) hX
    rw [Real.log_exp] at e
    dsimp [T]; linarith
  have he : Real.exp (T+1) = X := by dsimp [T]; rw [sub_add_cancel,Real.exp_log hX0]
  have heT : Real.exp T = X/Real.exp 1 := by simp only [T,Real.exp_sub,Real.exp_log hX0]
  have heP : Real.exp T * Real.exp (-(T/12)) ≤ X^(11/12 : ℝ) := by
    rw [← Real.exp_add,Real.rpow_def_of_pos hX0]
    apply Real.exp_le_exp.mpr
    dsimp only [T]
    linarith
  have hres := h T hT
  rw [he, mul_add] at hres
  apply hres.trans
  rw [← heT]
  exact add_le_add (le_refl _) (by
    calc
      Real.exp T * (C*Real.exp (-(T/12))) = C*(Real.exp T*Real.exp (-(T/12))) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_left heP hC)

#print axioms rightSet_finite
#print axioms rightSum_finite
#print axioms dyadic_endpoint_reduction_X
end RHConnections.PrimeRightCut
end

/- END AstraPrimeRightFinite.lean -/

/- BEGIN AstraPrimeRightEndpoint.lean -/

noncomputable section
namespace RHConnections.PrimeRightCut

def blockRight (Y : ℝ) := (Y/Real.exp 1)*dyadicRight (Real.log Y-1)

theorem chebyshev_endpoint_reduction :
    ∃ D : ℝ, 0 ≤ D ∧ ∀ X : ℝ, Real.exp 2 ≤ X →
      ∃ (n : ℕ) (Y : ℝ), Real.exp 2 ≤ Y ∧ Y < 2*Real.exp 2 ∧ X = 2^n*Y ∧
        |Chebyshev.psi X-X| ≤
          (∑ j ∈ Finset.range n, blockRight (2^j*Y)) + D*X^(11/12 : ℝ) := by
  obtain ⟨C,hC,hblock⟩ := dyadic_endpoint_reduction_X
  let p : ℝ := 11/12
  have hp : 0 < p := by norm_num [p]
  let q := (2:ℝ)^p
  have hq : 1 < q := Real.one_lt_rpow (by norm_num) hp
  let A := (Real.log 4+5)*(2*Real.exp 2)
  have hA : 0 ≤ A := by dsimp [A]; positivity
  let D := max A (C/(q-1))
  have hD : 0 ≤ D := hA.trans (le_max_left _ _)
  have hbudget : C+D ≤ D*q := by
    have hh := (div_le_iff₀ (sub_pos.mpr hq)).mp
      (show C/(q-1) ≤ D from le_max_right _ _)
    linarith
  refine ⟨D,hD,?_⟩
  intro X hX
  have he := Real.exp_pos 2
  have hx : 1 ≤ X/Real.exp 2 := (one_le_div he).mpr hX
  obtain ⟨n,hnL,hnU⟩ := exists_nat_pow_near hx (by norm_num : (1:ℝ)<2)
  let Y := X/(2:ℝ)^n
  have hn : (0:ℝ)<2^n := by positivity
  have hY : Real.exp 2 ≤ Y := (le_div_iff₀ hn).mpr <| by
    have hh := (le_div_iff₀ he).mp hnL
    linarith
  have hY' : Y < 2*Real.exp 2 := (div_lt_iff₀ hn).mpr <| by
    have hh := (div_lt_iff₀ he).mp hnU
    rw [pow_succ] at hh
    linarith
  have hid : X = 2^n*Y := by dsimp [Y]; field_simp
  have hY0 := he.trans_le hY
  have hOne : 1 ≤ Y := (Real.one_le_exp (by norm_num : (0:ℝ)≤2)).trans hY
  let Z (k : ℕ) := (2:ℝ)^k*Y
  have hZ (k : ℕ) : Real.exp 2 ≤ Z k := hY.trans <| le_mul_of_one_le_left hY0.le
    (one_le_pow₀ (by norm_num : (1:ℝ)≤2))
  have hZs (k : ℕ) : Z (k+1) = 2*Z k := by dsimp [Z]; rw [pow_succ]; ring
  have hsum (k : ℕ) : |Chebyshev.psi (Z k)-Z k| ≤
      (∑ j ∈ Finset.range k, blockRight (Z j)) + D*(Z k)^p := by
    induction k with
    | zero =>
      simp only [Z,pow_zero,one_mul,Finset.range_zero,Finset.sum_empty,zero_add]
      have hb := PrimeErrorLaplace.real_prime_error_linear hY0.le
      change |Chebyshev.psi Y-Y| ≤ (Real.log 4+5)*Y at hb
      calc
        _ ≤ (Real.log 4+5)*Y := hb
        _ ≤ A := mul_le_mul_of_nonneg_left hY'.le (by positivity)
        _ ≤ D := le_max_left _ _
        _ ≤ _ := le_mul_of_one_le_right hD (Real.one_le_rpow hOne hp.le)
    | succ k ih =>
      rw [hZs,Finset.sum_range_succ]
      have hb := hblock (Z k) (hZ k)
      change |(Chebyshev.psi (2*Z k)-Chebyshev.psi (Z k))-Z k| ≤ blockRight (Z k)+C*(Z k)^p at hb
      have hpow : (2*Z k)^p = (2:ℝ)^p*(Z k)^p :=
        Real.mul_rpow (by norm_num) (he.trans_le (hZ k)).le
      have herr := mul_le_mul_of_nonneg_right hbudget (Real.rpow_nonneg (he.trans_le (hZ k)).le p)
      change (2*Z k)^p = q*(Z k)^p at hpow
      rw [hpow]
      calc
        _ = |((Chebyshev.psi (2*Z k)-Chebyshev.psi (Z k))-Z k) + (Chebyshev.psi (Z k)-Z k)| := by congr 1; ring
        _ ≤ _ := (abs_add_le _ _).trans ((add_le_add hb ih).trans (by linarith))
  refine ⟨n,Y,hY,hY',hid,?_⟩
  change |Chebyshev.psi X-X| ≤ (∑ j ∈ Finset.range n, blockRight (Z j)) + D*X^p
  have hsame : X = Z n := hid
  rw [hsame]
  exact hsum n

#print axioms chebyshev_endpoint_reduction
end RHConnections.PrimeRightCut
end

