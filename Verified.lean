/- BEGIN ArithmeticFourierShell.lean -/

open Finset
noncomputable section
namespace RHConnections.ArithmeticFourierShell

def upperOddShell (X : ℕ) : Finset ℕ :=
  (Finset.Icc 1 X).filter (fun n => Odd n ∧ X < 2*n)

def monomials (X a b n : ℕ) : Finset ℕ :=
  (Finset.Icc 1 X).filter (fun m => m.Coprime 182 ∧ X < (2^b)*n*m ∧ (2^a)*n*m ≤ X)

def smoothPart (y n : ℕ) : ℕ :=
  ∏ p ∈ n.primeFactors, if p ≤ y then p^(n.factorization p) else 1

def projectedGram (y m n : ℕ) : ℝ :=
  ((Nat.gcd (smoothPart y m) (smoothPart y n) : ℝ)^2) / ((m:ℝ)*(n:ℝ))

def edgeWeight (a b : ℕ) : ℝ :=
  if a = 0 then ((2:ℝ)^b)⁻¹ else ((2:ℝ)^(b-a+1))⁻¹

def shellWeight (H : ℕ) : ℝ := ∑ b ∈ Finset.Ioc 0 H, ((2:ℝ)^b)⁻¹

def fourierWeight (X H y l k : ℕ) : ℝ :=
  ∑ a ∈ Finset.Icc 0 H, ∑ b ∈ Finset.Ioc a H, edgeWeight a b *
    ∑ m ∈ monomials X a b l, ∑ n ∈ monomials X a b k, projectedGram y m n

theorem upper_odd_shell_iff {X n : ℕ} : n ∈ upperOddShell X ↔
    1 ≤ n ∧ n ≤ X ∧ Odd n ∧ X < 2*n := by
  simp only [upperOddShell,mem_filter,Finset.mem_Icc,and_assoc]

theorem distinct_shell_indices_do_not_divide {X l k : ℕ} (hl : l ∈ upperOddShell X)
    (hk : k ∈ upperOddShell X) (hne : l ≠ k) : ¬ l ∣ k := by
  obtain ⟨hl0,hlX,_,hl2⟩ := upper_odd_shell_iff.mp hl
  obtain ⟨hk0,hkX,_,_⟩ := upper_odd_shell_iff.mp hk
  rintro ⟨a,rfl⟩
  have ha : 2 ≤ a := by
    by_contra! hn
    interval_cases a <;> simp_all
  have h2 := Nat.mul_le_mul_left l ha
  omega

theorem shell_monomials_zero_left {X b n : ℕ} (hn : n ∈ upperOddShell X) (hb : 0 < b) :
    monomials X 0 b n = {1} := by
  obtain ⟨hn0,hnX,_,hn2⟩ := upper_odd_shell_iff.mp hn
  have hpow : 2 ≤ (2:ℕ)^b := by
    simpa only [pow_one] using Nat.pow_le_pow_right (by norm_num : 0 < (2:ℕ)) (show 1 ≤ b from hb)
  ext m
  simp only [monomials,mem_filter,Finset.mem_Icc,pow_zero,one_mul,Finset.mem_singleton]
  constructor
  · rintro ⟨⟨hm1,hmX⟩,hc,hb,hU⟩
    by_contra hm
    have hm2 : 2 ≤ m := by omega
    have hle : 2*n ≤ n*m := by simpa only [Nat.mul_comm 2 n] using Nat.mul_le_mul_left n hm2
    omega
  · rintro rfl
    have hle := Nat.mul_le_mul_right n hpow
    simp only [mul_one]
    exact ⟨⟨le_rfl,hn0.trans hnX⟩,by decide,hn2.trans_le hle,hnX⟩

theorem shell_monomials_positive_left {X a b n : ℕ} (hn : n ∈ upperOddShell X) (ha : 0 < a) :
    monomials X a b n = ∅ := by
  obtain ⟨_,_,_,hn2⟩ := upper_odd_shell_iff.mp hn
  have hpow : 2 ≤ (2:ℕ)^a := by
    simpa only [pow_one] using Nat.pow_le_pow_right (by norm_num : 0 < (2:ℕ)) (show 1 ≤ a from ha)
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro m hm
  have h := mem_filter.mp hm
  have hle := Nat.mul_le_mul_right n hpow
  have hmul := Nat.mul_le_mul_left ((2^a)*n) (Finset.mem_Icc.mp h.1).1
  omega

theorem fourier_weight_on_shell {X l k : ℕ} (H y : ℕ)
    (hl : l ∈ upperOddShell X) (hk : k ∈ upperOddShell X) :
    fourierWeight X H y l k = shellWeight H := by
  unfold fourierWeight
  rw [sum_eq_single 0]
  · apply sum_congr rfl
    intro b hb
    have hb0 := (Finset.mem_Ioc.mp hb).1
    rw [shell_monomials_zero_left hl hb0,shell_monomials_zero_left hk hb0]
    simp [edgeWeight,projectedGram,smoothPart]
  · intro a _ ha
    apply sum_eq_zero
    intro b _
    rw [shell_monomials_positive_left hl (Nat.pos_of_ne_zero ha)]
    simp
  · simp

theorem shellWeight_eq (H : ℕ) : shellWeight H = 1-((2:ℝ)^H)⁻¹ := by
  induction H with
  | zero => simp [shellWeight]
  | succ H hi =>
    have he : Finset.Ioc (0:ℕ) (H+1) = insert (H+1) (Finset.Ioc 0 H) := by
      ext k
      simp only [Finset.mem_Ioc,Finset.mem_insert]
      omega
    rw [shellWeight,he,sum_insert (by simp),← shellWeight,hi,pow_succ,
      _root_.mul_inv_rev]
    norm_num
    ring

end RHConnections.ArithmeticFourierShell
end

/- END ArithmeticFourierShell.lean -/

/- BEGIN ArithmeticFourierPairBlock.lean -/

open Finset ArithmeticFunction
noncomputable section
namespace RHConnections.ArithmeticFourierShell
open ArithmeticFourierInversion

def pairedSeeds (X : ℕ) : Finset ℕ :=
  (Finset.Icc 1 X).filter (fun d => Odd d ∧ Squarefree d ∧ d.Coprime 165 ∧ X < 22*d ∧ 15*d ≤ X)

def pairedBlock (X : ℕ) : Finset ℕ :=
  ((pairedSeeds X).image (fun d => 11*d)) ∪ ((pairedSeeds X).image (fun d => 15*d))

theorem paired_seed_iff {X d : ℕ} : d ∈ pairedSeeds X ↔
    1 ≤ d ∧ Odd d ∧ Squarefree d ∧ d.Coprime 165 ∧ X < 22*d ∧ 15*d ≤ X := by
  simp only [pairedSeeds,mem_filter,Finset.mem_Icc,and_assoc]
  constructor
  · exact fun h => ⟨h.1,h.2.2⟩
  · exact fun h => ⟨h.1, by omega, h.2⟩

private theorem seed_coprime {X d : ℕ} (hd : d ∈ pairedSeeds X) :
    Nat.Coprime 11 d ∧ Nat.Coprime 15 d := by
  have h := (paired_seed_iff.mp hd).2.2.2.1.symm
  change Nat.Coprime (11*15) d at h
  exact Nat.coprime_mul_iff_left.mp h

theorem paired_block_in_shell (X : ℕ) : pairedBlock X ⊆ upperOddShell X := by
  intro n hn
  rw [pairedBlock,Finset.mem_union] at hn
  rcases hn with h | h
  · obtain ⟨d,hd,rfl⟩ := mem_image.mp h
    obtain ⟨hd₁,hdodd,_,_,hlo,hhi⟩ := paired_seed_iff.mp hd
    exact upper_odd_shell_iff.mpr ⟨by omega,by omega,(by decide : Odd (11:ℕ)).mul hdodd,by omega⟩
  · obtain ⟨d,hd,rfl⟩ := mem_image.mp h
    obtain ⟨hd₁,hdodd,_,_,hlo,hhi⟩ := paired_seed_iff.mp hd
    exact upper_odd_shell_iff.mpr ⟨by omega,hhi,(by decide : Odd (15:ℕ)).mul hdodd,by omega⟩

theorem paired_images_disjoint (X : ℕ) :
    Disjoint ((pairedSeeds X).image (fun d => 11*d)) ((pairedSeeds X).image (fun d => 15*d)) := by
  rw [Finset.disjoint_left]
  intro n h₁ h₂
  obtain ⟨d,_,rfl⟩ := mem_image.mp h₁
  obtain ⟨e,he,hee⟩ := mem_image.mp h₂
  have hdiv : 11 ∣ 15*e := ⟨d,hee⟩
  have h11e : 11 ∣ e := (Nat.Coprime.dvd_mul_left (by decide : Nat.Coprime 11 15)).mp hdiv
  have h := (seed_coprime he).1
  rw [Nat.coprime_iff_gcd_eq_one, Nat.gcd_eq_left h11e] at h
  omega

private theorem mobius_eleven_mul {X d : ℕ} (hd : d ∈ pairedSeeds X) :
    muR (11*d) = -muR d := by
  have h := isMultiplicative_moebius.map_mul_of_coprime (seed_coprime hd).1
  have h11 : moebius 11 = -1 := moebius_apply_prime (by decide : Nat.Prime 11)
  rw [h11,neg_one_mul] at h
  change (moebius (11*d):ℝ) = -(moebius d:ℝ)
  exact_mod_cast h

private theorem mobius_fifteen_mul {X d : ℕ} (hd : d ∈ pairedSeeds X) :
    muR (15*d) = muR d := by
  have h15 : moebius 15 = 1 := by
    change moebius (3*5) = 1
    rw [isMultiplicative_moebius.map_mul_of_coprime (by decide : Nat.Coprime 3 5),
      moebius_apply_prime Nat.prime_three,moebius_apply_prime (by decide : Nat.Prime 5)]
    norm_num
  have h := isMultiplicative_moebius.map_mul_of_coprime (seed_coprime hd).2
  rw [h15,one_mul] at h
  change (moebius (15*d):ℝ) = (moebius d:ℝ)
  exact_mod_cast h

private theorem image_scale_injective {a : ℕ} (ha : 0 < a) : Function.Injective (fun d : ℕ => a*d) :=
  fun _ _ h => Nat.eq_of_mul_eq_mul_left ha h

theorem paired_block_card (X : ℕ) : (pairedBlock X).card = 2*(pairedSeeds X).card := by
  rw [pairedBlock,card_union_of_disjoint (paired_images_disjoint X),
    card_image_of_injective _ (image_scale_injective (by norm_num : (0:ℕ)<11)),
    card_image_of_injective _ (image_scale_injective (by norm_num : (0:ℕ)<15))]
  omega

theorem paired_block_balanced (X : ℕ) : ∑ n ∈ pairedBlock X, muR n = 0 := by
  rw [pairedBlock,sum_union (paired_images_disjoint X),
    sum_image (image_scale_injective (by norm_num : (0:ℕ)<11)).injOn,
    sum_image (image_scale_injective (by norm_num : (0:ℕ)<15)).injOn,← sum_add_distrib]
  exact sum_eq_zero fun d hd => by rw [mobius_eleven_mul hd,mobius_fifteen_mul hd,neg_add_cancel]

theorem paired_block_unit_squares {X n : ℕ} (hn : n ∈ pairedBlock X) : (muR n)^2 = 1 := by
  rw [pairedBlock,Finset.mem_union] at hn
  rcases hn with h | h
  · obtain ⟨d,hd,rfl⟩ := mem_image.mp h
    rw [mobius_eleven_mul hd,neg_sq]
    have h := moebius_sq_eq_one_of_squarefree (paired_seed_iff.mp hd).2.2.1
    change (moebius d:ℝ)^2 = 1
    exact_mod_cast h
  · obtain ⟨d,hd,rfl⟩ := mem_image.mp h
    rw [mobius_fifteen_mul hd]
    have h := moebius_sq_eq_one_of_squarefree (paired_seed_iff.mp hd).2.2.1
    change (moebius d:ℝ)^2 = 1
    exact_mod_cast h

end RHConnections.ArithmeticFourierShell
end

/- END ArithmeticFourierPairBlock.lean -/

/- BEGIN ArithmeticFourierShellMertens.lean -/

open Finset ArithmeticFunction
noncomputable section
namespace RHConnections.ArithmeticFourierShell
open ArithmeticFourierInversion

def oddUpTo (X : ℕ) : Finset ℕ := (Finset.Icc 1 X).filter Odd

theorem upper_odd_shell_eq_sdiff (X : ℕ) :
    upperOddShell X = oddUpTo X \ oddUpTo (X/2) := by
  ext n
  simp only [upper_odd_shell_iff,Finset.mem_sdiff,oddUpTo,Finset.mem_filter,Finset.mem_Icc]
  constructor
  · rintro ⟨hn,hX,hO,hlo⟩
    exact ⟨⟨⟨hn,hX⟩,hO⟩,fun h => by omega⟩
  · rintro ⟨⟨⟨hn,hX⟩,hO⟩,hN⟩
    exact ⟨hn,hX,hO,by by_contra! h; exact hN ⟨⟨hn,by omega⟩,hO⟩⟩

private theorem mobius_double (n : ℕ) : muR (2*n) = if Odd n then -muR n else 0 := by
  by_cases hn : Odd n
  · rw [if_pos hn]
    have h := isMultiplicative_moebius.map_mul_of_coprime (Nat.coprime_two_left.mpr hn)
    rw [moebius_apply_prime Nat.prime_two,neg_one_mul] at h
    change (moebius (2*n):ℝ) = -(moebius n:ℝ)
    exact_mod_cast h
  · rw [if_neg hn]
    obtain ⟨k,hk⟩ := Nat.not_odd_iff_even.mp hn
    have hd : 2*2 ∣ 2*n := ⟨k,by rw [hk]; ring⟩
    have hsq : ¬Squarefree (2*n) := fun h =>
      (Nat.squarefree_iff_prime_squarefree.mp h 2 Nat.prime_two) hd
    change (moebius (2*n):ℝ) = 0
    exact_mod_cast moebius_eq_zero_of_not_squarefree hsq

private theorem even_up_to_image (X : ℕ) :
    (Finset.Icc 1 X).filter (fun n => ¬ Odd n) =
      (Finset.Icc 1 (X/2)).image (fun n => 2*n) := by
  ext n
  simp only [mem_filter,Finset.mem_Icc,Finset.mem_image,Nat.not_odd_iff_even]
  constructor
  · rintro ⟨⟨hn,hX⟩,⟨k,hk⟩⟩
    exact ⟨k,⟨by omega,by omega⟩,by omega⟩
  · rintro ⟨k,⟨hk,hkX⟩,rfl⟩
    exact ⟨⟨by omega,by omega⟩,⟨k,by ring⟩⟩

theorem odd_shell_sum_eq_M (X : ℕ) : ∑ n ∈ upperOddShell X, muR n = M X := by
  classical
  have hodd : oddUpTo (X/2) ⊆ oddUpTo X := by
    intro n hn
    have h := mem_filter.mp hn
    exact mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨(Finset.mem_Icc.mp h.1).1,by have := (Finset.mem_Icc.mp h.1).2; omega⟩,h.2⟩
  have hSplit : (∑ n ∈ Finset.Icc 1 X, muR n) =
      (∑ n ∈ oddUpTo X, muR n) + ∑ n ∈ (Finset.Icc 1 X).filter (fun n => ¬Odd n), muR n := by
    symm
    exact sum_filter_add_sum_filter_not (Finset.Icc 1 X) Odd _
  have hEven : (∑ n ∈ (Finset.Icc 1 X).filter (fun n => ¬ Odd n),muR n) =
      -∑ n ∈ oddUpTo (X/2),muR n := by
    rw [even_up_to_image,sum_image (show Function.Injective (fun n : ℕ => 2*n) from
      fun l k h => by change 2*l=2*k at h; omega).injOn]
    simp_rw [mobius_double]
    rw [← sum_filter]
    simp only [oddUpTo,sum_neg_distrib]
  have hI : Finset.Ioc (0:ℕ) X = Finset.Icc 1 X := by
    ext n
    simp only [Finset.mem_Ioc,Finset.mem_Icc]
    omega
  have hD : (∑ n ∈ oddUpTo X \ oddUpTo (X/2),muR n) +
      (∑ n ∈ oddUpTo (X/2),muR n) = ∑ n ∈ oddUpTo X,muR n := sum_sdiff hodd
  rw [upper_odd_shell_eq_sdiff,M,hI,hSplit,hEven]
  linarith

theorem balanced_complement_sum_eq_M {X : ℕ} {A : Finset ℕ} (hA : A ⊆ upperOddShell X)
    (hzero : ∑ n ∈ A, muR n = 0) :
    ∑ n ∈ upperOddShell X \ A, muR n = M X := by
  have he : (∑ n ∈ upperOddShell X \ A,muR n)+(∑ n ∈ A,muR n) =
      ∑ n ∈ upperOddShell X,muR n := sum_sdiff hA
  rwa [hzero,add_zero,odd_shell_sum_eq_M] at he

end RHConnections.ArithmeticFourierShell
end

/- END ArithmeticFourierShellMertens.lean -/

/- BEGIN ArithmeticFourierComplementBound.lean -/

open Finset ArithmeticFunction
noncomputable section
namespace RHConnections.ArithmeticFourierShell
open ArithmeticFourierInversion

def increasingPairs (C : Finset ℕ) : Finset (ℕ × ℕ) :=
  (C.product C).filter (fun p => p.1 < p.2)

def longPairs (C : Finset ℕ) (H : ℕ) : Finset (ℕ × ℕ) :=
  (increasingPairs C).filter (fun p => p.1+2*H < p.2)

def shortPairs (C : Finset ℕ) (H : ℕ) : Finset (ℕ × ℕ) :=
  (increasingPairs C).filter (fun p => ¬ p.1+2*H < p.2)

def nonzeroMobius (C : Finset ℕ) : Finset ℕ := C.filter (fun n => muR n ≠ 0)

def shellLongContribution (X H y : ℕ) (C : Finset ℕ) : ℝ :=
  2*∑ p ∈ longPairs C H, muR p.1*muR p.2*fourierWeight X H y p.1 p.2

theorem sum_increasing_pairs (C : Finset ℕ) (f : ℕ → ℝ) :
    2*(∑ p ∈ increasingPairs C, f p.1*f p.2) =
      (∑ n ∈ C, f n)^2 - ∑ n ∈ C, (f n)^2 := by
  let V := fun l k => if l < k then f l*f k else 0
  let D := fun l k => if l = k then (f l)^2 else 0
  have hV : ∑ p ∈ increasingPairs C, f p.1*f p.2 = ∑ l ∈ C, ∑ k ∈ C, V l k := by
    simp [increasingPairs,sum_filter,sum_product,V]
  have hswap : (∑ l ∈ C,∑ k ∈ C, V k l) = ∑ l ∈ C,∑ k ∈ C,V l k := sum_comm
  have hD : (∑ l ∈ C,∑ k ∈ C,D l k) = ∑ l ∈ C,(f l)^2 := by
    apply sum_congr rfl
    intro l hl
    simp [D,hl]
  have hpoint (l k : ℕ) : f l*f k = D l k+V l k+V k l := by
    rcases lt_trichotomy l k with hl | rfl | hk
    · simp [D,V,hl,hl.ne,not_lt_of_ge hl.le]
    · simp [D,V,pow_two]
    · simp [D,V,hk,hk.ne',not_lt_of_ge hk.le,mul_comm]
  have hS : (∑ n ∈ C,f n)^2 = (∑ n ∈ C,(f n)^2)+2*(∑ l ∈ C,∑ k ∈ C,V l k) := by
    rw [pow_two, sum_mul]
    simp_rw [mul_sum,hpoint,sum_add_distrib]
    rw [hswap,hD]
    have htwo : (∑ l ∈ C,∑ k ∈ C, 2*V l k) = 2*(∑ l ∈ C,∑ k ∈ C, V l k) := by
      simp_rw [Finset.mul_sum]
    rw [htwo]
    ring
  rw [hV,hS]
  ring

private theorem shortPairs_card_le {C : Finset ℕ} (hC : ∀ n ∈ C, Odd n) (H : ℕ) :
    (shortPairs C H).card ≤ H*C.card := by
  let F : ℕ × ℕ → ℕ × ℕ := fun p => (p.1,(p.2-p.1)/2)
  have hp (p : ℕ × ℕ) (hm : p ∈ shortPairs C H) :
      p.1 ∈ C ∧ 1 ≤ (p.2-p.1)/2 ∧ (p.2-p.1)/2 ≤ H ∧ p.2=p.1+2*((p.2-p.1)/2) := by
    rcases p with ⟨l,k⟩
    obtain ⟨hInc,hshort⟩ := Finset.mem_filter.mp hm
    obtain ⟨hmem,hlt⟩ := Finset.mem_filter.mp hInc
    have hl := (Finset.mem_product.mp hmem).1
    have hk := (Finset.mem_product.mp hmem).2
    obtain ⟨i,hi⟩ := hC l hl
    obtain ⟨j,hj⟩ := hC k hk
    exact ⟨hl,by omega,by omega,by omega⟩
  have hmap : Set.MapsTo F (shortPairs C H) (C.product (Finset.Icc 1 H)) := by
    intro p hm
    have h := hp p hm
    exact mem_product.mpr ⟨h.1,Finset.mem_Icc.mpr ⟨h.2.1,h.2.2.1⟩⟩
  have hinj : (shortPairs C H : Set (ℕ × ℕ)).InjOn F := by
    intro p hm q hn he
    apply Prod.ext
    · have h : (F p).1 = (F q).1 := congrArg Prod.fst he
      exact h
    · have h₁ := congrArg Prod.fst he
      have h₂ := congrArg Prod.snd he
      change p.1=q.1 at h₁
      change (p.2-p.1)/2=(q.2-q.1)/2 at h₂
      have hp' := (hp p hm).2.2.2
      have hq' := (hp q hn).2.2.2
      omega
  have h := card_le_card_of_injOn F hmap hinj
  change (shortPairs C H).card ≤ (C.product (Finset.Icc 1 H)).card at h
  simpa [Finset.card_product,Nat.card_Icc,mul_comm] using h

private theorem muR_abs_le_one (n : ℕ) : |muR n| ≤ 1 := by
  change |(moebius n:ℝ)| ≤ 1
  exact_mod_cast (abs_moebius_le_one (n := n))

private theorem muR_sq_of_nonzero {n : ℕ} (hn : muR n ≠ 0) : (muR n)^2 = 1 := by
  have h : moebius n ≠ 0 := by
    change (moebius n:ℝ) ≠ 0 at hn
    exact_mod_cast hn
  have hq := moebius_sq_eq_one_of_squarefree (moebius_ne_zero_iff_squarefree.mp h)
  change (moebius n:ℝ)^2 = 1
  exact_mod_cast hq

private theorem nonzeroMobius_subset (C : Finset ℕ) : nonzeroMobius C ⊆ C := filter_subset _ _

private theorem long_pair_sum_filter_mobius (C : Finset ℕ) (H : ℕ) :
    ∑ p ∈ longPairs (nonzeroMobius C) H, muR p.1*muR p.2 =
      ∑ p ∈ longPairs C H, muR p.1*muR p.2 := by
  apply sum_subset
  · intro p hp
    obtain ⟨hInc,hlong⟩ := Finset.mem_filter.mp hp
    obtain ⟨hp,hlt⟩ := Finset.mem_filter.mp hInc
    obtain ⟨h₁,h₂⟩ := mem_product.mp hp
    exact mem_filter.mpr ⟨mem_filter.mpr ⟨mem_product.mpr
      ⟨nonzeroMobius_subset C h₁,nonzeroMobius_subset C h₂⟩,hlt⟩,hlong⟩
  · intro p hp hnot
    obtain ⟨hInc,hlong⟩ := Finset.mem_filter.mp hp
    obtain ⟨hp,hlt⟩ := Finset.mem_filter.mp hInc
    obtain ⟨h₁,h₂⟩ := mem_product.mp hp
    by_contra hn
    obtain ⟨g₁,g₂⟩ := mul_ne_zero_iff.mp hn
    apply hnot
    exact mem_filter.mpr ⟨mem_filter.mpr
      ⟨mem_product.mpr ⟨mem_filter.mpr ⟨h₁,g₁⟩,mem_filter.mpr ⟨h₂,g₂⟩⟩,hlt⟩,hlong⟩

theorem complement_long_pair_bound {X : ℕ} {A : Finset ℕ} (hA : A ⊆ upperOddShell X)
    (hzero : ∑ n ∈ A, muR n = 0) (H y : ℕ) :
    let C := upperOddShell X \ A
    |shellLongContribution X H y C - shellWeight H*(M X)^2| ≤
      shellWeight H*(1+2*(H:ℝ))*(nonzeroMobius C).card := by
  let C := upperOddShell X \ A
  let D := nonzeroMobius C
  let Q : ℝ := D.card
  let w := shellWeight H
  have hw : 0 ≤ w := sum_nonneg fun _ _ => by positivity
  have hD : D ⊆ C := nonzeroMobius_subset _
  have hC : C ⊆ upperOddShell X := Finset.sdiff_subset
  have hsum : ∑ n ∈ D, muR n = M X := by
    rw [← balanced_complement_sum_eq_M hA hzero]
    apply sum_subset hD
    intro n hn hnd
    by_contra hn'
    exact hnd (mem_filter.mpr ⟨hn,hn'⟩)
  have hsq : (∑ n ∈ D, (muR n)^2) = Q := by
    calc
      _ = ∑ _n ∈ D, (1:ℝ) := Finset.sum_congr rfl
        (fun _ hn => muR_sq_of_nonzero (Finset.mem_filter.mp hn).2)
      _ = _ := by simp [Q]
  have hAll := sum_increasing_pairs D muR
  rw [hsum,hsq] at hAll
  have hSplit : (∑ p ∈ longPairs D H, muR p.1*muR p.2) +
    (∑ p ∈ shortPairs D H, muR p.1*muR p.2) =
    ∑ p ∈ increasingPairs D, muR p.1*muR p.2 :=
    sum_filter_add_sum_filter_not (increasingPairs D) (fun p => p.1+2*H<p.2) _
  have hAbs : |∑ p ∈ shortPairs D H, muR p.1*muR p.2| ≤ (H:ℝ)*Q := by
    calc
      _ ≤ ∑ p ∈ shortPairs D H, |muR p.1*muR p.2| := by
        simpa only [Real.norm_eq_abs] using norm_sum_le (shortPairs D H) (fun p => muR p.1*muR p.2)
      _ ≤ ∑ _p ∈ shortPairs D H, (1:ℝ) := sum_le_sum fun p _ => by
        rw [abs_mul]
        exact (mul_le_mul (muR_abs_le_one _) (muR_abs_le_one _) (abs_nonneg _) zero_le_one).trans_eq (one_mul _)
      _ ≤ _ := by
        have hcount := shortPairs_card_le (C := D)
          (fun n hn => (upper_odd_shell_iff.mp (hC (hD hn))).2.2.1) H
        simp only [sum_const,nsmul_eq_mul,mul_one,Q]
        exact_mod_cast hcount
  have hlong : shellLongContribution X H y C =
      2*w*(∑ p ∈ longPairs D H, muR p.1*muR p.2) := by
    unfold shellLongContribution
    have he : (∑ p ∈ longPairs C H,muR p.1*muR p.2*fourierWeight X H y p.1 p.2) =
        ∑ p ∈ longPairs C H,muR p.1*muR p.2*w := by
      apply sum_congr rfl
      intro p hp
      obtain ⟨hmem,_⟩ := mem_filter.mp (mem_filter.mp hp).1
      obtain ⟨h₁,h₂⟩ := mem_product.mp hmem
      rw [fourier_weight_on_shell H y (hC h₁) (hC h₂)]
    rw [he,← sum_mul,← long_pair_sum_filter_mobius C H]
    ring
  let U := ∑ p ∈ shortPairs D H, muR p.1*muR p.2
  have hrel : shellLongContribution X H y C - w*(M X)^2 = -w*Q-2*w*U := by
    rw [hlong]
    dsimp only [U]
    linear_combination w*(hAll+2*hSplit)
  change |shellLongContribution X H y C-w*(M X)^2| ≤ w*(1+2*(H:ℝ))*Q
  rw [hrel]
  have hQ : 0 ≤ Q := Nat.cast_nonneg _
  calc
    _ ≤ |-w*Q|+|2*w*U| := abs_sub _ _
    _ = w*Q+2*w*|U| := by
      rw [abs_mul (-w),abs_neg,abs_of_nonneg hw,abs_of_nonneg hQ,abs_mul (2*w),
        abs_of_nonneg (mul_nonneg (by norm_num : (0:ℝ) ≤ 2) hw)]
    _ ≤ w*Q+2*w*((H:ℝ)*Q) := add_le_add le_rfl (mul_le_mul_of_nonneg_left hAbs (mul_nonneg (by norm_num : (0:ℝ) ≤ 2) hw))
    _ = _ := by ring

end RHConnections.ArithmeticFourierShell
end

