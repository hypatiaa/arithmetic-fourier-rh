theorem fixed_strip_iff_one_sided_dyadic_prime_error {a σ : ℝ}
    (ha : 1/2≤a) (ha1 : a<1) (hσ : σ=1 ∨ σ= -1) :
    (∀ s : ℂ, a<s.re → riemannZeta s≠0) ↔
      (∀ ε : ℝ, 0<ε → ∃ C : ℝ, 0≤C ∧
        ∀ᶠ X : ℝ in atTop, -(C*X^(a+ε))≤σ*realDyadicPrimeError X) := by
