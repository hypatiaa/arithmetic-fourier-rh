/- BEGIN RankCenteredContrast.lean -/

noncomputable section
namespace RHConnections.RankContrast

variable {ι : Type*}

def mean (s : Finset ι) (z : ι → ℂ) : ℂ :=
  (∑ i∈s,z i)/(s.card:ℂ)

def contrast (A B : Finset ι) (length : ι → ℝ) (v : ι → ℂ) : ℂ :=
  mean A (fun i => v i/(length i:ℂ)) - mean B (fun i => v i/(length i:ℂ))

private theorem centered_mean {s : Finset ι} (hs : s.Nonempty) (length : ι → ℝ)
    (v : ι → ℂ) (c : ℂ) (hL : ∀ i∈s, 0<length i) :
    mean s (fun i => v i/(length i:ℂ))-c =
      mean s (fun i => (v i-c*(length i:ℂ))/(length i:ℂ)) := by
  unfold mean
  rw [sub_eq_iff_eq_add]
  have he : ∀ i∈s, (v i-c*(length i:ℂ))/(length i:ℂ) =
      v i/(length i:ℂ)-c := by
    intro i hi
    have hx := Complex.ofReal_ne_zero.mpr (hL i hi).ne'
    field_simp
  rw [Finset.sum_congr rfl he,Finset.sum_sub_distrib,Finset.sum_const,nsmul_eq_mul]
  have hc : (s.card:ℂ)≠0 := Nat.cast_ne_zero.mpr (Finset.card_ne_zero.mpr hs)
  field_simp
  <;> ring

private theorem mean_cost {s : Finset ι} (hs : s.Nonempty) {rows : Finset ι} (hsub : s⊆rows)
    (length : ι → ℝ) (v : ι → ℂ) (c : ℂ) {L : ℝ} (hL : 0<L)
    (hlen : ∀ i∈s, L≤length i) :
    ‖mean s (fun i => (v i-c*(length i:ℂ))/(length i:ℂ))‖ ≤
      (Real.sqrt (∑ i∈rows,‖v i-c*(length i:ℂ)‖^2)/(Real.sqrt (s.card:ℝ)*L)) := by
  let r (i : ι) := ‖v i-c*(length i:ℂ)‖
  have hc : (0:ℝ)<s.card := by exact_mod_cast hs.card_pos
  let E := ∑ i∈rows,r i^2
  have hE : 0≤E := by dsimp [E]; positivity
  have hcauchy : (∑ i∈s,r i)^2 ≤ (s.card:ℝ)*E := by
    have hh := Finset.sum_mul_sq_le_sq_mul_sq s r (fun _ => (1:ℝ))
    have hv : (∑ i∈s,r i^2)≤E :=
      Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ => sq_nonneg _)
    simp only [mul_one,one_pow,Finset.sum_const,nsmul_eq_mul,mul_one] at hh
    exact hh.trans ((mul_le_mul_of_nonneg_right hv hc.le).trans_eq (by ring))
  have hsum : (∑ i∈s,r i) ≤ Real.sqrt (s.card:ℝ)*Real.sqrt E := by
    rw [← Real.sqrt_mul hc.le]
    exact (Real.le_sqrt (by positivity) (by positivity)).mpr hcauchy
  have hterm (i) (hi : i∈s) :
      ‖(v i-c*(length i:ℂ))/(length i:ℂ)‖ ≤ r i/L := by
    rw [norm_div,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (hL.trans_le (hlen i hi))]
    exact div_le_div_of_nonneg_left (norm_nonneg _) hL (hlen i hi)
  rw [mean,norm_div,Complex.norm_natCast]
  calc
    _ ≤ (∑ i∈s,r i/L)/(s.card:ℝ) := by
      gcongr
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum hterm)
    _ = (∑ i∈s,r i)/(L*(s.card:ℝ)) := by rw [←Finset.sum_div,div_div]
    _ ≤ (Real.sqrt (s.card:ℝ)*Real.sqrt E)/(L*(s.card:ℝ)) :=
      div_le_div_of_nonneg_right hsum (by positivity)
    _ = _ := by
      change _ = Real.sqrt E/(Real.sqrt (s.card:ℝ)*L)
      field_simp
      rw [Real.sq_sqrt hc.le]
      ring

theorem centered_contrast_le {A B rows : Finset ι} (hA : A.Nonempty) (hB : B.Nonempty)
    (ha : A⊆rows) (hb : B⊆rows) (length : ι → ℝ) (v : ι → ℂ)
    (c : ℂ) {L : ℝ} (hL : 0<L)
    (hAl : ∀ i∈A, L≤length i) (hBl : ∀ i∈B, L≤length i) :
    ‖contrast A B length v‖ ≤
      Real.sqrt (∑ i∈rows,‖v i-c*(length i:ℂ)‖^2)*
        ((Real.sqrt (A.card:ℝ)*L)⁻¹+(Real.sqrt (B.card:ℝ)*L)⁻¹) := by
  unfold contrast
  rw [←sub_sub_sub_cancel_right _ _ c,centered_mean hA length v c
    (fun i hi => hL.trans_le (hAl i hi)),centered_mean hB length v c
    (fun i hi => hL.trans_le (hBl i hi))]
  exact ((norm_sub_le _ _).trans (add_le_add
    (mean_cost hA ha length v c hL hAl) (mean_cost hB hb length v c hL hBl))).trans_eq (by ring)

end RHConnections.RankContrast
end

/- END RankCenteredContrast.lean -/

/- BEGIN RankGroupMean.lean -/

noncomputable section
namespace RHConnections.RankContrast

variable {ι : Type*}

theorem difference_of_group_means (A B : Finset ι) (hA : A.Nonempty) (hB : B.Nonempty)
    (v : ι → ℂ) :
    mean A v - mean B v =
      (∑ i∈A, ∑ j∈B,(v i-v j))/((A.card:ℂ)*(B.card:ℂ)) := by
  have ha : (A.card:ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Finset.card_ne_zero.mpr hA)
  have hb : (B.card:ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Finset.card_ne_zero.mpr hB)
  simp only [mean,Finset.sum_sub_distrib,Finset.sum_const,nsmul_eq_mul,←Finset.mul_sum]
  field_simp

theorem lower_group_contrast (A B : Finset ι) (hA : A.Nonempty) (hB : B.Nonempty)
    (v : ι → ℂ) (rotation : ℂ) (d : ℝ)
    (hl : ∀ i∈A, ∀ j∈B, d≤(rotation*(v i-v j)).re) :
    d≤(rotation*(mean A v-mean B v)).re := by
  rw [difference_of_group_means A B hA hB]
  have ha : (0:ℝ)<A.card := by exact_mod_cast hA.card_pos
  have hb : (0:ℝ)<B.card := by exact_mod_cast hB.card_pos
  have he : (rotation * (∑ i ∈ A, ∑ j ∈ B, (v i-v j)) /
      ((A.card:ℂ)*(B.card:ℂ))).re =
      (∑ i∈A,∑ j∈B, (rotation*(v i-v j)).re)/((A.card:ℝ)*(B.card:ℝ)) := by
    rw [Finset.mul_sum]
    simp_rw [Finset.mul_sum]
    have hcast : ((A.card:ℂ)*(B.card:ℂ))=(((A.card:ℝ)*(B.card:ℝ):ℝ):ℂ) := by norm_cast
    rw [hcast,Complex.div_ofReal_re]
    change Complex.reCLM (∑ i∈A,∑ j∈B,rotation*(v i-v j)) / _ = _
    simp only [map_sum,Complex.reCLM_apply]

  have hreal : d*((A.card:ℝ)*(B.card:ℝ)) ≤ ∑ i∈A,∑ j∈B,(rotation*(v i-v j)).re := by
    calc
      _ = ∑ _i∈A,∑ _j∈B,d := by simp only [Finset.sum_const,nsmul_eq_mul]; ring
      _ ≤ _ := Finset.sum_le_sum (fun i hi => Finset.sum_le_sum (hl i hi))
  rw [←mul_div_assoc,he]
  exact (le_div_iff₀ (mul_pos ha hb)).mpr hreal

end RHConnections.RankContrast
end

/- END RankGroupMean.lean -/

/- BEGIN RankContrastTransfer.lean -/

noncomputable section
namespace RHConnections.RankContrast

variable {ι : Type*}

theorem contrast_add (A B : Finset ι) (length : ι → ℝ) (v w : ι → ℂ) :
    contrast A B length (fun i => v i+w i) =
      contrast A B length v + contrast A B length w := by
  simp only [contrast,mean,add_div,Finset.sum_add_distrib]
  ring

theorem contrast_length_multiple (A B : Finset ι) (hA : A.Nonempty) (hB : B.Nonempty)
    (length : ι → ℝ) (hpos : ∀ i, i∈A ∨ i∈B → 0<length i) (c : ℂ) :
    contrast A B length (fun i => c*(length i:ℂ))=0 := by
  have hmean (s : Finset ι) (hs : s.Nonempty) (hl : ∀ i∈s, 0<length i) :
      mean s (fun i => (c*(length i:ℂ))/(length i:ℂ))=c := by
    unfold mean
    rw [Finset.sum_congr rfl (fun i hi => mul_div_cancel_right₀ c
      (Complex.ofReal_ne_zero.mpr (hl i hi).ne')),Finset.sum_const,nsmul_eq_mul]
    exact mul_div_cancel_left₀ c (Nat.cast_ne_zero.mpr (Finset.card_ne_zero.mpr hs))
  unfold contrast
  rw [hmean A hA (fun i hi => hpos i (Or.inl hi)),hmean B hB (fun i hi => hpos i (Or.inr hi)),sub_self]

theorem contrast_uniform_error (A B : Finset ι) (hA : A.Nonempty) (hB : B.Nonempty)
    (length : ι → ℝ) (v : ι → ℂ) {L E : ℝ} (hL : 0<L) (hE : 0≤E)
    (hlen : ∀ i, i∈A ∨ i∈B → L≤length i)
    (herr : ∀ i, i∈A ∨ i∈B → ‖v i‖≤E) :
    ‖contrast A B length v‖≤2*E/L := by
  have hmean (s : Finset ι) (hs : s.Nonempty) (hl : ∀ i∈s, L≤length i)
      (he : ∀ i∈s, ‖v i‖≤E) : ‖mean s (fun i => v i/(length i:ℂ))‖≤E/L := by
    have hcard : (0:ℝ)<s.card := by exact_mod_cast hs.card_pos
    rw [mean,norm_div,Complex.norm_natCast]
    calc
      _ ≤ (∑ _i∈s,E/L)/(s.card:ℝ) := by
        apply div_le_div_of_nonneg_right _ hcard.le
        apply (norm_sum_le _ _).trans
        apply Finset.sum_le_sum
        intro i hi
        rw [norm_div,Complex.norm_real,Real.norm_eq_abs,abs_of_pos (hL.trans_le (hl i hi))]
        exact (div_le_div_of_nonneg_right (he i hi) (hL.trans_le (hl i hi)).le).trans
          (div_le_div_of_nonneg_left hE hL (hl i hi))
      _ = _ := by
        rw [Finset.sum_const,nsmul_eq_mul]
        exact mul_div_cancel_left₀ _ hcard.ne'
  exact ((norm_sub_le _ _).trans (add_le_add
    (hmean A hA (fun i hi => hlen i (Or.inl hi)) (fun i hi => herr i (Or.inl hi)))
    (hmean B hB (fun i hi => hlen i (Or.inr hi)) (fun i hi => herr i (Or.inr hi))))).trans_eq (by ring)

theorem contrast_transfer_of_length_error {A B rows : Finset ι}
    (hA : A.Nonempty) (hB : B.Nonempty) (ha : A⊆rows) (hb : B⊆rows)
    (physical grid : ι → ℝ) (v w : ι → ℂ) (c : ℂ) (scale : ℝ)
    {L E W : ℝ} (hL : 0<L) (hE : 0≤E) (hW : 0≤W)
    (hlen : ∀ i, i∈A ∨ i∈B → L≤physical i)
    (hval : ∀ i, i∈A ∨ i∈B → ‖w i-v i‖≤E)
    (hwidth : ∀ i, i∈A ∨ i∈B → |grid i-scale*physical i|≤W) :
    ‖contrast A B physical w‖ ≤
      Real.sqrt (∑ i∈rows,‖v i-c*(grid i:ℂ)‖^2) *
        ((Real.sqrt (A.card:ℝ)*L)⁻¹+(Real.sqrt (B.card:ℝ)*L)⁻¹) +
      2*(E+‖c‖*W)/L := by
  let D (i : ι) := v i-c*(grid i:ℂ)
  let err (i : ι) := w i-v i+c*((grid i-scale*physical i:ℝ):ℂ)
  have hdecomp : w=(fun i => (D i+err i)+(c*(scale:ℂ))*(physical i:ℂ)) := by
    ext i
    simp only [D,err,Complex.ofReal_sub,Complex.ofReal_mul]
    ring
  have hsum :
      contrast A B physical w=contrast A B physical D+contrast A B physical err := by
    conv_lhs => rw [hdecomp]
    rw [contrast_add,contrast_add,contrast_length_multiple A B hA hB physical
      (fun i hi => hL.trans_le (hlen i hi)),add_zero]
  rw [hsum]
  have hD := centered_contrast_le hA hB ha hb physical D 0 hL
    (fun i hi => hlen i (Or.inl hi)) (fun i hi => hlen i (Or.inr hi))
  have he (i) (hi : i∈A ∨ i∈B) : ‖err i‖≤E+‖c‖*W := by
    refine (norm_add_le _ _).trans ?_
    rw [norm_mul,Complex.norm_real,Real.norm_eq_abs]
    exact add_le_add (hval i hi) (mul_le_mul_of_nonneg_left (hwidth i hi) (norm_nonneg _))
  have her := contrast_uniform_error A B hA hB physical err hL
    (show 0≤E+‖c‖*W by positivity) hlen he
  exact (norm_add_le _ _).trans (add_le_add (by simpa [D] using hD) her)

end RHConnections.RankContrast
end

/- END RankContrastTransfer.lean -/

/- BEGIN RankFittedConstant.lean -/

noncomputable section
namespace RHConnections.RankContrast

variable {ι : Type*} [Fintype ι]

def fittedConstant (w length v : ι → ℝ) : ℝ :=
  (∑ i,w i*length i*v i)/(∑ i,w i*(length i)^2)

def centeredEnergy (w length v : ι → ℝ) (c : ℝ) : ℝ :=
  ∑ i,w i*(v i-c*length i)^2

theorem fitted_constant_identity (w length v : ι → ℝ) (c : ℝ)
    (hA : 0<∑ i,w i*(length i)^2) :
    centeredEnergy w length v c =
      centeredEnergy w length v (fittedConstant w length v) +
      (c-fittedConstant w length v)^2*(∑ i,w i*(length i)^2) := by
  let d := fittedConstant w length v
  let A := ∑ i,w i*(length i)^2
  let S := ∑ i,w i*length i*v i
  have hAd : d*A=S := by
    change S/A*A=S
    exact div_mul_cancel₀ _ hA.ne'
  have hzero : (∑ i,w i*length i*(v i-d*length i))=0 := by
    have he (i : ι) : w i*length i*(v i-d*length i)=
        w i*length i*v i-d*(w i*(length i)^2) := by ring
    simp only [he,Finset.sum_sub_distrib,←Finset.mul_sum]
    change S-d*A=0
    rw [hAd,sub_self]
  change centeredEnergy w length v c = centeredEnergy w length v d + (c-d)^2*A
  unfold centeredEnergy
  calc
    _ = ∑ i,(w i*(v i-d*length i)^2 + (c-d)^2*(w i*(length i)^2) -
         (2*(c-d))*(w i*length i*(v i-d*length i))) := by
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = _ := by simp only [Finset.sum_sub_distrib,Finset.sum_add_distrib,←Finset.mul_sum,
      hzero,mul_zero,sub_zero,A]

theorem fitted_constant_minimizes (w length v : ι → ℝ) (c : ℝ)
    (hA : 0<∑ i,w i*(length i)^2) :
    centeredEnergy w length v (fittedConstant w length v) ≤ centeredEnergy w length v c := by
  rw [fitted_constant_identity w length v c hA]
  exact le_add_of_nonneg_right (mul_nonneg (sq_nonneg _) hA.le)

theorem fitted_constant_bound (w length v : ι → ℝ) {D : ℝ}
    (hw : ∀ i, 0≤w i) (hl : ∀ i, 0≤length i)
    (hA : 0<∑ i,w i*(length i)^2) (hv : ∀ i, |v i|≤D*length i) :
    |fittedConstant w length v|≤D := by
  rw [fittedConstant,abs_div,abs_of_pos hA]
  apply (div_le_iff₀ hA).mpr
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  calc
    _ ≤ ∑ i, D*(w i*(length i)^2) := by
      apply Finset.sum_le_sum
      intro i _
      rw [abs_mul,abs_of_nonneg (mul_nonneg (hw i) (hl i))]
      exact (mul_le_mul_of_nonneg_left (hv i) (mul_nonneg (hw i) (hl i))).trans_eq (by ring)
    _ = _ := by rw [Finset.mul_sum]

end RHConnections.RankContrast
end

/- END RankFittedConstant.lean -/

/- BEGIN CenteredDistanceTransfer.lean -/

noncomputable section
namespace RHConnections.RankContrast
variable {ι : Type*} [Fintype ι]

def weightedRowVector (w v : ι → ℝ) : EuclideanSpace ℝ ι :=
  WithLp.toLp 2 (fun i => Real.sqrt (w i)*v i)

theorem norm_weighted_row (w v : ι → ℝ) (hw : ∀ i, 0≤w i) :
    ‖weightedRowVector w v‖ = Real.sqrt (∑ i,w i*(v i)^2) := by
  simp only [weightedRowVector, PiLp.norm_eq_of_L2,Real.norm_eq_abs,sq_abs,mul_pow,
    Real.sq_sqrt (hw _)]

def centeredDistance (w length v : ι → ℝ) : ℝ :=
  Real.sqrt (centeredEnergy w length v (fittedConstant w length v))

theorem centered_distance_one_direction (w length v u : ι → ℝ)
    (hw : ∀ i,0≤w i) (hA : 0<∑ i,w i*(length i)^2) :
    centeredDistance w length v ≤
      ‖weightedRowVector w (fun i => v i-u i)‖+centeredDistance w length u := by
  let c := fittedConstant w length u
  have hd : weightedRowVector w (fun i => v i-c*length i) =
      weightedRowVector w (fun i => v i-u i)+weightedRowVector w (fun i => u i-c*length i) := by
    ext i
    change Real.sqrt (w i)*(v i-c*length i) =
      Real.sqrt (w i)*(v i-u i)+Real.sqrt (w i)*(u i-c*length i)
    ring
  refine (Real.sqrt_le_sqrt (fitted_constant_minimizes w length v c hA)).trans ?_
  rw [show Real.sqrt (centeredEnergy w length v c)=
      ‖weightedRowVector w (fun i => v i-c*length i)‖ by rw [norm_weighted_row w _ hw]; rfl,hd]
  refine (norm_add_le _ _).trans_eq ?_
  simp only [norm_weighted_row w _ hw]
  rfl

theorem centered_distance_lipschitz (w length v u : ι → ℝ)
    (hw : ∀ i,0≤w i) (hA : 0<∑ i,w i*(length i)^2) :
    |centeredDistance w length v-centeredDistance w length u| ≤
      Real.sqrt (∑ i,w i*(v i-u i)^2) := by
  apply abs_sub_le_iff.mpr
  have h₁ := centered_distance_one_direction w length v u hw hA
  have h₂ := centered_distance_one_direction w length u v hw hA
  rw [norm_weighted_row w _ hw] at h₁ h₂
  have he (i : ι) : (u i-v i)^2=(v i-u i)^2 := by ring
  simp only [he] at h₂
  exact ⟨by linarith only [h₁],by linarith only [h₂]⟩

theorem centered_distance_uniform_error (w length v u : ι → ℝ)
    (hw : ∀ i,0≤w i) (hA : 0<∑ i,w i*(length i)^2)
    (N E : ℝ) (hN : 0≤N) (hE : 0≤E)
    (hs : ∑ i,w i ≤ N) (he : ∀ i, |v i-u i|≤E) :
    |centeredDistance w length v-centeredDistance w length u|≤Real.sqrt N*E := by
  apply (centered_distance_lipschitz w length v u hw hA).trans
  have hsq : (∑ i,w i*(v i-u i)^2)≤N*E^2 := by
    calc
      _ ≤ ∑ i,w i*E^2 := by
        apply Finset.sum_le_sum
        intro i _
        rw [←sq_abs (v i-u i)]
        exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (abs_nonneg _) (he i) _) (hw i)
      _ = (∑ i,w i)*E^2 := (Finset.sum_mul ..).symm
      _ ≤ _ := mul_le_mul_of_nonneg_right hs (sq_nonneg _)
  exact (Real.sqrt_le_sqrt hsq).trans_eq (by rw [Real.sqrt_mul hN,Real.sqrt_sq hE])

end RHConnections.RankContrast
end

/- END CenteredDistanceTransfer.lean -/

/- BEGIN AstraLocalModeContrast.lean -/

open Filter Set MeasureTheory
open scoped Topology
noncomputable section

namespace RHConnections.LocalModeContrast

def segment (a b s : ℝ) : ℝ := (1-s)*a+s*b

def normalizedMean (g : ℝ → ℂ) (a b : ℝ) : ℂ :=
  ∫ s in (0:ℝ)..1, g (segment a b s)

private theorem segment_mem {a b l u s : ℝ} (ha : a ∈ Ioo l u) (hb : b ∈ Ioo l u)
    (hs : s ∈ Icc (0:ℝ) 1) : segment a b s ∈ Ioo l u := by
  exact (convex_Ioo l u) ha hb (sub_nonneg.mpr hs.2) hs.1 (sub_add_cancel _ _)

private theorem segment_cont (a b : ℝ) : Continuous (segment a b) := by
  unfold segment
  fun_prop

theorem local_mean_contrast {g v : ℝ → ℂ} (hd : ∀ᶠ y in 𝓝 (1:ℝ), HasDerivAt g (v y) y)
    (hv : ContinuousAt v 1) (hne : v 1 ≠ 0) :
    ∃ r : ℝ, 0 < r ∧ ∀ {a b c e d : ℝ},
      a ∈ Ioo (1-r) (1+r) → b ∈ Ioo (1-r) (1+r) →
      c ∈ Ioo (1-r) (1+r) → e ∈ Ioo (1-r) (1+r) →
      0 < d → d ≤ c-a → d ≤ e-b →
      d/2 ≤ ((normalizedMean g c e - normalizedMean g a b)/(v 1)).re := by
  let F (y : ℝ) := (g y / v 1).re
  let V (y : ℝ) := (v y / v 1).re
  have hV : ContinuousAt V 1 := Complex.continuous_re.continuousAt.comp (hv.div_const _)
  have hV1 : V 1 = 1 := by simp [V,hne]
  have hhalf : ∀ᶠ y in 𝓝 (1:ℝ), 1/2 < V y :=
    hV.eventually (lt_mem_nhds (by rw [hV1]; norm_num))
  obtain ⟨r,hr,hrange⟩ := Metric.eventually_nhds_iff.mp (hd.and hhalf)
  refine ⟨r,hr,?_⟩
  let I := Ioo (1-r) (1+r)
  have hloc {y : ℝ} (hy : y ∈ I) : HasDerivAt g (v y) y ∧ 1/2 < V y := by
    apply hrange
    rw [Real.dist_eq,abs_lt]
    exact ⟨by linarith [hy.1], by linarith [hy.2]⟩
  have hDF {y : ℝ} (hy : y ∈ I) : HasDerivAt F (V y) y :=
    Complex.reCLM.hasFDerivAt.comp_hasDerivAt y ((hloc hy).1.div_const (v 1))
  have hcont : ContinuousOn g I := fun y hy => (hloc hy).1.continuousAt.continuousWithinAt
  have hFcont : ContinuousOn F I := fun y hy => (hDF hy).continuousAt.continuousWithinAt
  intro a b c e d ha hb hc he hdpos hca heb
  have hint {p q : ℝ} (hp : p ∈ I) (hq : q ∈ I) :
      IntegrableOn (fun s => g (segment p q s)) (Ioc (0:ℝ) 1) := by
    exact (hcont.comp (segment_cont p q).continuousOn (fun _ hs => segment_mem hp hq hs)).integrableOn_Icc.mono_set Ioc_subset_Icc_self
  have hiA := hint ha hb
  have hiC := hint hc he
  let D (s : ℝ) := (g (segment c e s) - g (segment a b s))/v 1
  have hiD : IntegrableOn D (Ioc (0:ℝ) 1) := (hiC.sub hiA).div_const _
  have hproj : IntegrableOn (fun s => (D s).re) (Ioc (0:ℝ) 1) :=
    Complex.reCLM.integrable_comp hiD
  have hmean : ((normalizedMean g c e-normalizedMean g a b)/v 1).re =
      ∫ s in Ioc (0:ℝ) 1, (D s).re := by
    rw [show (∫ s in Ioc (0:ℝ) 1, (D s).re) = (∫ s in Ioc (0:ℝ) 1, D s).re from integral_re hiD]
    simp only [D, normalizedMean,intervalIntegral.integral_of_le zero_le_one,integral_div,integral_sub hiC hiA]
  rw [hmean]
  calc
    _ = ∫ _s in Ioc (0:ℝ) 1, d/2 := by simp
    _ ≤ _ := by
      apply setIntegral_mono_on (integrableOn_const measure_Ioc_lt_top.ne) hproj measurableSet_Ioc
      intro s hs
      have hss : s ∈ Icc (0:ℝ) 1 := ⟨hs.1.le,hs.2⟩
      let x := segment a b s
      let y := segment c e s
      have hx : x ∈ I := segment_mem ha hb hss
      have hy : y ∈ I := segment_mem hc he hss
      have hgap : d ≤ y-x := by
        dsimp [x,y,segment]
        nlinarith [mul_le_mul_of_nonneg_left hca (sub_nonneg.mpr hs.2),
          mul_le_mul_of_nonneg_left heb hs.1.le]
      have hxy : x < y := by linarith
      have hsub {t : ℝ} (ht : t ∈ Icc x y) : t ∈ I := ⟨hx.1.trans_le ht.1, ht.2.trans_lt hy.2⟩
      obtain ⟨t,ht,htv⟩ := exists_hasDerivAt_eq_slope F V hxy (hFcont.mono (fun _ => hsub))
        (fun _ ht => hDF (hsub ⟨ht.1.le,ht.2.le⟩))
      have hslope := (hloc (hsub ⟨ht.1.le,ht.2.le⟩)).2
      have hm := (eq_div_iff (sub_ne_zero.mpr hxy.ne')).mp htv
      have hmul := mul_le_mul_of_nonneg_right hslope.le (sub_nonneg.mpr hxy.le)
      change d/2 ≤ ((g y-g x)/v 1).re
      rw [sub_div,Complex.sub_re]
      change d/2 ≤ F y-F x
      linarith

def logMode (rho : ℂ) (y : ℝ) : ℂ := Complex.exp ((rho-1)*(Real.log y : ℂ))

theorem logMode_mean_contrast (rho : ℂ) (hρ : rho ≠ 1) :
    ∃ r : ℝ, 0 < r ∧ ∀ {a b c e d : ℝ},
      a ∈ Ioo (1-r) (1+r) → b ∈ Ioo (1-r) (1+r) →
      c ∈ Ioo (1-r) (1+r) → e ∈ Ioo (1-r) (1+r) →
      0 < d → d ≤ c-a → d ≤ e-b →
      d/2 ≤ ((normalizedMean (logMode rho) c e - normalizedMean (logMode rho) a b)/(rho-1)).re := by
  let v (y : ℝ) := logMode rho y * ((rho-1)*(y⁻¹:ℝ))
  have h1 : v 1 = rho-1 := by simp [v,logMode]
  have hd : ∀ᶠ y in 𝓝 (1:ℝ), HasDerivAt (logMode rho) (v y) y := by
    filter_upwards [lt_mem_nhds (by norm_num : (0:ℝ)<1)] with y hy
    exact (((Real.hasDerivAt_log hy.ne').ofReal_comp).const_mul (rho-1)).cexp
  have hv : ContinuousAt v 1 := by
    dsimp [v,logMode]
    fun_prop (disch := norm_num)
  simpa only [h1] using local_mean_contrast hd hv (h1 ▸ sub_ne_zero.mpr hρ)

#print axioms local_mean_contrast
#print axioms logMode_mean_contrast
end RHConnections.LocalModeContrast
end

/- END AstraLocalModeContrast.lean -/

/- BEGIN AstraUnitRotatedContrast.lean -/

open Filter Set
open scoped Topology
noncomputable section
namespace RHConnections.LocalModeContrast

def unitRotation (w : ℂ) : ℂ := (‖w‖ : ℂ)/w

theorem unitRotation_norm {w : ℂ} (hw : w ≠ 0) : ‖unitRotation w‖ = 1 := by
  simp [unitRotation,Complex.norm_real,hw]

theorem unit_rotated_contrast {g : ℝ → ℂ} (hg : ContDiffAt ℝ 1 g 1) (hne : deriv g 1 ≠ 0) :
    ∃ r : ℝ, 0 < r ∧ ∀ {a b c e d : ℝ},
      a ∈ Ioo (1-r) (1+r) → b ∈ Ioo (1-r) (1+r) →
      c ∈ Ioo (1-r) (1+r) → e ∈ Ioo (1-r) (1+r) →
      0 < d → d ≤ c-a → d ≤ e-b →
      d*‖deriv g 1‖/2 ≤
        (unitRotation (deriv g 1)*(normalizedMean g c e - normalizedMean g a b)).re := by
  obtain ⟨L,U,hU,hL,hgL⟩ := contDiffAt_one_iff.mp hg
  let v (y : ℝ) := L y 1
  have hv : ContinuousAt v 1 := (hL.continuousAt hU).clm_apply continuousAt_const
  have hd : ∀ᶠ y in 𝓝 (1:ℝ), HasDerivAt g (v y) y := by
    filter_upwards [hU] with y hy
    exact (hgL y hy).hasDerivAt
  have h1 : deriv g 1 = v 1 := hd.self_of_nhds.deriv
  obtain ⟨r,hr,h⟩ := local_mean_contrast hd hv (h1 ▸ hne)
  refine ⟨r,hr,?_⟩
  intro a b c e d ha hb hc he hd0 hca heb
  have hbound := h ha hb hc he hd0 hca heb
  rw [← h1] at hbound
  let w := deriv g 1
  let D := normalizedMean g c e - normalizedMean g a b
  change d/2 ≤ (D/w).re at hbound
  change d*‖w‖/2 ≤ (unitRotation w*D).re
  have hu : unitRotation w*D = (‖w‖ : ℂ)*(D/w) := by unfold unitRotation; ring
  simp only [hu,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
  linarith [mul_le_mul_of_nonneg_left hbound (norm_nonneg w)]

#print axioms unitRotation_norm
#print axioms unit_rotated_contrast
end RHConnections.LocalModeContrast
end

/- END AstraUnitRotatedContrast.lean -/

/- BEGIN ZeroPrimitiveMean.lean -/

noncomputable section
open Set MeasureTheory
namespace RHConnections.LocalModeContrast

def zeroPrimitive (rho : ℂ) (y : ℝ) : ℂ :=
  Complex.exp (rho*(Real.log y:ℂ))/rho

theorem zero_primitive_derivative {rho : ℂ} (hr : rho≠0) {y : ℝ} (hy : 0<y) :
    HasDerivAt (zeroPrimitive rho) (logMode rho y) y := by
  have h := ((((Real.hasDerivAt_log hy.ne').ofReal_comp).const_mul rho).cexp).div_const rho
  have he : logMode rho y =
      Complex.exp (rho*(Real.log y:ℂ))*(rho*((y⁻¹:ℝ):ℂ))/rho := by
    unfold logMode
    rw [sub_mul,one_mul,Complex.exp_sub,←Complex.ofReal_exp,Real.exp_log hy,Complex.ofReal_inv]
    field_simp [hr,Complex.ofReal_ne_zero.mpr hy.ne']
    <;> ring
  rw [he]
  exact h

theorem zero_primitive_scales (rho : ℂ) {L y : ℝ} (hL : 0<L) (hy : 0<y) :
    zeroPrimitive rho (L*y) = Complex.exp (rho*(Real.log L:ℂ))*zeroPrimitive rho y := by
  unfold zeroPrimitive
  rw [Real.log_mul hL.ne' hy.ne',Complex.ofReal_add,mul_add,Complex.exp_add]
  ring

theorem zero_primitive_difference_eq_mean {rho : ℂ} (hr : rho≠0) {a b : ℝ}
    (ha : 0<a) (hb : 0<b) :
    zeroPrimitive rho b-zeroPrimitive rho a = ((b-a:ℝ):ℂ)*normalizedMean (logMode rho) a b := by
  let G (s : ℝ) := zeroPrimitive rho (segment a b s)
  let g (s : ℝ) := logMode rho (segment a b s)*((b-a:ℝ):ℂ)
  have hpos (s) (hs : s ∈ Icc (0:ℝ) 1) : 0<segment a b s :=
    (convex_Ioi (0:ℝ)) ha hb (sub_nonneg.mpr hs.2) hs.1 (sub_add_cancel _ _)
  have hseg (s : ℝ) : HasDerivAt (segment a b) (b-a) s := by
    have hx := (((hasDerivAt_const s (1:ℝ)).sub (hasDerivAt_id s)).mul_const a).add
      ((hasDerivAt_id s).mul_const b)
    convert hx using 1
    · rfl
    · ring
  have hder (s) (hs : s∈Icc (0:ℝ) 1) : HasDerivAt G (g s) s :=
    by simpa [G,g,Function.comp_def,Algebra.smul_def,mul_comm] using
      (zero_primitive_derivative hr (hpos s hs)).scomp s (hseg s)
  have hg : ContinuousOn g (uIcc (0:ℝ) 1) := by
    rw [Set.uIcc_of_le zero_le_one]
    intro s hs
    have hh : ContinuousAt (logMode rho) (segment a b s) := by
      change ContinuousAt (fun y : ℝ => Complex.exp ((rho-1)*(Real.log y:ℂ))) (segment a b s)
      fun_prop (disch := exact (hpos s hs).ne')
    exact ((hh.comp (by unfold segment; fun_prop)).mul continuousAt_const).continuousWithinAt
  have he := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun s hs => hder s (by simpa only [Set.uIcc_of_le zero_le_one] using hs))
    hg.intervalIntegrable
  have h01 : segment a b 0=a := by simp [segment]
  have h11 : segment a b 1=b := by simp [segment]
  simp only [G,h01,h11,g,intervalIntegral.integral_mul_const] at he
  unfold normalizedMean
  rw [mul_comm]
  exact he.symm

theorem scaled_zero_primitive_difference {rho : ℂ} (hr : rho≠0) {L a b : ℝ}
    (hL : 0<L) (ha : 0<a) (hb : 0<b) :
    zeroPrimitive rho (L*b)-zeroPrimitive rho (L*a) =
        (Complex.exp (rho*(Real.log L:ℂ))*((b-a:ℝ):ℂ))*normalizedMean (logMode rho) a b := by
  rw [zero_primitive_scales rho hL ha,zero_primitive_scales rho hL hb,←mul_sub,
    zero_primitive_difference_eq_mean hr ha hb]
  ring

end RHConnections.LocalModeContrast
